<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo oscuro de la web: lienzo casi negro con resplandores vino suaves -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#020617" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.0"
                android:centerY="0.0"
                android:gradientRadius="420dp"
                android:startColor="#3D790D2B"
                android:endColor="#00790D2B" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="1.0"
                android:centerY="1.0"
                android:gradientRadius="380dp"
                android:startColor="#2EB42345"
                android:endColor="#00B42345" />
        </shape>
    </item>
</layer-list>
