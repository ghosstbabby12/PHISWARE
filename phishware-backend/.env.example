# Copia este archivo como .env y rellena los valores reales
# Google Safe Browsing: https://console.cloud.google.com → APIs → Safe Browsing API
GOOGLE_SAFE_BROWSING_KEY=YOUR_KEY_HERE

# VirusTotal: https://www.virustotal.com/gui/my-apikey (requiere cuenta gratuita)
VIRUSTOTAL_KEY=YOUR_KEY_HERE

# Base de datos (cambia si usas credenciales distintas)
DB_USERNAME=phishware
DB_PASSWORD=phishware2024

# JWT (cámbialo en producción)
JWT_SECRET=phishware-super-secret-key-2024-must-be-at-least-256-bits-long-for-hs256
