<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Phishware" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/proton_primary</item>
        <item name="colorPrimaryDark">@color/proton_primary_dark</item>
        <item name="colorOnPrimary">@color/proton_on_brand</item>
        <item name="colorSecondary">@color/proton_primary</item>
        <item name="colorOnSecondary">@color/proton_on_brand</item>
        <item name="android:colorBackground">@color/proton_bg</item>
        <item name="colorSurface">@color/proton_card</item>
        <item name="colorOnSurface">@color/proton_text</item>
        <item name="colorOnSurfaceVariant">@color/proton_subtext</item>
        <item name="colorError">@color/danger_red</item>
        <item name="android:statusBarColor">@color/proton_bg</item>
        <item name="android:navigationBarColor">@color/proton_card</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <style name="Theme.Phishware.Splash" parent="Theme.Phishware">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>

    <style name="Phishware.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/rose_wash</item>
    </style>
</resources>
