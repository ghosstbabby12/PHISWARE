# Copia este archivo como .env y rellena los valores reales. NUNCA subas el .env.
# Google Safe Browsing: https://console.cloud.google.com -> APIs -> Safe Browsing API
GOOGLE_SAFE_BROWSING_KEY=tu_api_key_de_google_aqui

# VirusTotal: https://www.virustotal.com/gui/my-apikey (requiere cuenta gratuita)
VIRUSTOTAL_KEY=tu_api_key_de_virustotal_aqui

# Base de datos (cambia si usas credenciales distintas)
DB_USERNAME=phishware
DB_PASSWORD=cambia_esta_clave_en_tu_env

# JWT (obligatorio en produccion, minimo 32 caracteres aleatorios)
JWT_SECRET=cambia_este_secreto_por_uno_aleatorio_de_al_menos_32_caracteres
