<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo de la web: lienzo claro con dos resplandores vino en esquinas opuestas -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F7F7FA" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.0"
                android:centerY="0.0"
                android:gradientRadius="420dp"
                android:startColor="#1F790D2B"
                android:endColor="#00790D2B" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="1.0"
                android:centerY="1.0"
                android:gradientRadius="380dp"
                android:startColor="#1AB42345"
                android:endColor="#00B42345" />
        </shape>
    </item>
</layer-list>
